{
  "name": "agent-cy",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first creative copilot for short-form video creators",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:server": "pnpm --filter @agent-cy/server dev",
    "mcp:build": "pnpm --filter @agent-cy/mcp build",
    "mcp:package": "pnpm --filter @agent-cy/mcp build:standalone",
    "mcp:setup": "pnpm --filter @agent-cy/mcp run setup",
    "mcp:start": "pnpm --filter @agent-cy/mcp start",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
