{
  "name": "@agent-cy/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "agentcy-mcp": "./dist/index.js",
    "agentcy-local-cy": "./dist/local-cy.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:standalone": "pnpm build && node scripts/build-standalone.mjs",
    "local-cy": "node dist/local-cy.js",
    "local-cy:install": "pnpm build && node scripts/install-local-cy.mjs",
    "start": "node dist/index.js",
    "setup": "pnpm build && node scripts/setup.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-cy/contracts": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.210",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "node": "24.18.0",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
