NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Use fixture locally. Production must use anthropic.
AI_PROVIDER=fixture
ANTHROPIC_API_KEY=

# Replace every value below in a deployed environment.
INVITE_HASH_SECRET=agent-cy-local-invite-hash-secret-only
INSTALLATION_HASH_SECRET=agent-cy-local-installation-hash-secret-only
# Hashes the private callback capability that the local bridge uses to request
# a review notification. Keep it distinct from every other server secret.
BRIDGE_NOTIFICATION_HASH_SECRET=agent-cy-local-bridge-notification-hash-secret-only
# One-way hashes Apple account subjects before durable storage. Keep it distinct
# from every invitation and installation credential secret.
APPLE_SUBJECT_HASH_SECRET=agent-cy-local-apple-subject-hash-secret-only
APPLE_CLIENT_IDS=com.agentcy.app
PUBLIC_BASE_URL=http://127.0.0.1:3000
# During credential-secret rotation, put the prior secret(s) here, comma-separated.
PREVIOUS_INSTALLATION_HASH_SECRETS=
# Production codes must be unique and use at least 20 characters across three
# character classes. Keep the local value simple only for fixture development.
INVITE_CODES=local-pilot-code
# Optional shared expiry for the currently configured invitation cohort.
INVITE_EXPIRES_AT=
# The first external TestFlight cohort is promotional. Production defaults to
# true until the paid App Store cohort begins.
PILOT_COMPED_ACCESS=false
PILOT_COMPED_DURATION_DAYS=28
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_ID=creator_access

# Configure all APNs values together to enable closed-app review alerts.
# Store the .p8 private key in the deployment secret manager, never in this file.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
APNS_ENVIRONMENT=development

DATA_FILE=./data/agent-cy-state.json
REQUEST_TIMEOUT_MS=90000
BODY_LIMIT_BYTES=131072
SHORT_WINDOW_LIMIT=10
DAILY_OPERATION_LIMIT=50
DAILY_COST_LIMIT_MICROS=1000000
TELEMETRY_RETENTION_DAYS=30
